# Copy to .env.selfhost and set private values before starting Compose.
# This example does not enable AI or Stripe payments.
OVERTO_SELF_HOSTED=true
OVERTO_DB_PASSWORD=replace-with-strong-random-password
OVERTO_DATABASE_URL=postgresql://overto:replace-with-strong-random-password@postgres:5432/overto
OVERTO_AUTH_SECRET=replace-with-at-least-32-random-characters
OVERTO_CLIENT_IDENTITY_SALT=replace-with-at-least-32-random-salt-characters
OVERTO_TRUST_PROXY=false
BETTER_AUTH_URL=http://127.0.0.1:3006
OVERTO_PUBLIC_URL=http://127.0.0.1:3006
OVERTO_HOST_PORT=3006
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=no-reply@example.org
# SMTP_USER=
# SMTP_PASSWORD=
AI_ENABLED=false
AI_PRODUCTION_ENABLED=false
AI_ANONYMOUS_ENABLED=false
AI_EMERGENCY_DISABLE=false
# Configure OPENAI_BASE_URL, OPENAI_MODEL and OPENAI_API_KEY privately before enabling AI.
# Confirm current model prices in Admin > AI Studio > Models before the first paid call.
STRIPE_TEST_ENABLED=false
OVERTO_BILLING_MODE=disabled
OVERTO_BILLING_CHECKOUT_ENABLED=false
OVERTO_STRIPE_AUTOMATIC_TAX=false
OVERTO_LIVE_BILLING_ACTIVATED=false
# STRIPE_TEST_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_LIVE_WEBHOOK_SECRET=
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
# For isolated production-mode QA only: OVERTO_ANALYTICS_ENVIRONMENT=qa
