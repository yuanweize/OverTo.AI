# Local testing only: bind the dev server to 127.0.0.1. Never expose this mode publicly.
AI_ENABLED=true
AI_LOCAL_ONLY=true
AI_EXTERNAL_RATE_LIMIT_CONFIRMED=false
OPENAI_BASE_URL=https://api.openlux.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional local-only account experiment; requires a dedicated local PostgreSQL.
# Leave disabled for any public or production deployment.
OVERTO_AUTH_LOCAL=false
OVERTO_LOCAL_VERIFY_EMAIL=false
OVERTO_DEV_DATABASE_URL=
OVERTO_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3005

# Stripe test-mode setup is planned, not enabled or integrated yet.
# Never put live Stripe keys here; do not commit real test credentials.
STRIPE_TEST_ENABLED=false
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_ID=
STRIPE_TEST_MONTHLY_CREDITS=
