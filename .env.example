# Local testing only: bind the dev server to 127.0.0.1. Never expose this mode publicly.
AI_ENABLED=true
AI_LOCAL_ONLY=true
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional comma-separated additional HTTPS-compatible endpoints registered by the operator.
# AI_ALLOWED_BASE_URLS=https://gateway.example/v1
# AI_PROVIDER_NAME=Compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional PostHog EU product analytics. Explicit browser consent is required.
# The project token is public, but configure it privately for each deployment.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Optional local-only account experiment; requires a dedicated local PostgreSQL.
# Leave disabled for any public or production deployment.
OVERTO_AUTH_LOCAL=false
OVERTO_LOCAL_VERIFY_EMAIL=false
OVERTO_DEV_DATABASE_URL=
OVERTO_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3005

# Stripe Test Mode is experimental and disabled pending real end-to-end validation.
# Never put live Stripe keys here; do not commit real test credentials.
STRIPE_TEST_ENABLED=false
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_ID=
STRIPE_TEST_MONTHLY_CREDITS=

# Versioned billing catalog (separate from the legacy local Test Mode checkout).
# Keep disabled until sandbox checkout, signed webhooks, refunds and reconciliation pass.
OVERTO_BILLING_MODE=disabled
OVERTO_BILLING_CHECKOUT_ENABLED=false
# Enable only after configuring Stripe Tax for the merchant and local obligations.
OVERTO_STRIPE_AUTOMATIC_TAX=false
OVERTO_LIVE_BILLING_ACTIVATED=false
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_LIVE_WEBHOOK_SECRET=

# Canonical origin for preference writes behind a reverse proxy (not a secret).
# OVERTO_PUBLIC_URL=https://your-domain.example
